{
  "name": "inkbook",
  "version": "0.1.0",
  "description": "墨本 Inkbook —— Obsidian 里的 A4 手写笔记本",
  "main": "main.js",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
